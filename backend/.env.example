# ---- copy to .env and fill in. NEVER commit .env ----
APP_ENV=development                 # use "production" on Render
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require   # Neon connection string

# Optional shared key for /api/* (the PayPal webhook route is exempt). Set it on Render.
API_KEY=
ENABLE_DEMO=true                    # Demo Lab endpoints (synthetic data only)
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000   # comma-separated CORS origins (add your deployed frontend URL)

# ---- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                  # from the webhook you add on the app page (needs a public URL)
ALLOW_UNVERIFIED_WEBHOOKS=false     # dev only; unverified events are stored but never trusted

# ---- LLM via OpenRouter ----
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Free model names change: check openrouter.ai/models (filter: free)
OPENROUTER_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free
