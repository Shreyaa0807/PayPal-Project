{
  "info": {
    "name": "PayPal PaymentOps AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All endpoints. Set baseUrl (e.g. http://localhost:8000), apiKey (if API_KEY is set), incidentId, orderId."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Demo Lab (synthetic)",
      "item": [
        {
          "name": "List scenarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "scenarios"
              ]
            }
          }
        },
        {
          "name": "A - Timeout after success (+investigate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios/A?investigate=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "scenarios",
                "A?investigate=true"
              ]
            }
          }
        },
        {
          "name": "B - Payment pending (+investigate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios/B?investigate=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "scenarios",
                "B?investigate=true"
              ]
            }
          }
        },
        {
          "name": "C - Duplicate webhook (+investigate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios/C?investigate=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "scenarios",
                "C?investigate=true"
              ]
            }
          }
        },
        {
          "name": "D - State mismatch (+investigate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/scenarios/D?investigate=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "scenarios",
                "D?investigate=true"
              ]
            }
          }
        },
        {
          "name": "Seed all",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/seed-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "seed-all"
              ]
            }
          }
        },
        {
          "name": "Reset synthetic data",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "reset"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Search transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/search?q=SYN",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "search?q=SYN"
              ]
            }
          }
        },
        {
          "name": "Transaction detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{orderId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "List (filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents?severity=high&status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents?severity=high&status=open"
              ]
            }
          }
        },
        {
          "name": "Open incident by transaction ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{orderId}}\"\n}"
            }
          }
        },
        {
          "name": "Incident detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}"
              ]
            }
          }
        },
        {
          "name": "Timeline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/timeline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "timeline"
              ]
            }
          }
        },
        {
          "name": "Investigate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/investigate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "investigate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"use_llm\": true,\n  \"actor\": \"judge\"\n}"
            }
          }
        },
        {
          "name": "Ingest event (merchant log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"LOCAL_STATE_RECORDED\",\n  \"transaction_state\": \"COMPLETED\",\n  \"payload\": {\n    \"note\": \"reconciled\"\n  }\n}"
            }
          }
        },
        {
          "name": "Resolve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolved_by\": \"judge\",\n  \"note\": \"reconciled\"\n}"
            }
          }
        },
        {
          "name": "Audit log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "audit"
              ]
            }
          }
        },
        {
          "name": "Report (JSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "report"
              ]
            }
          }
        },
        {
          "name": "Report (Markdown)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents/{{incidentId}}/report?format=md",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents",
                "{{incidentId}}",
                "report?format=md"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "PayPal Sandbox",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/paypal/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paypal",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10.00\",\n  \"currency\": \"USD\",\n  \"description\": \"Sandbox test\"\n}"
            }
          }
        },
        {
          "name": "Get current order state",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/paypal/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paypal",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Capture (human-approved)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/paypal/orders/{{orderId}}/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paypal",
                "orders",
                "{{orderId}}",
                "capture"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved_by\": \"judge\",\n  \"confirm\": true\n}"
            }
          }
        }
      ]
    }
  ]
}